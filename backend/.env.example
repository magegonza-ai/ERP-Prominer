# ==============================================================
# AGAS Cilindros - Plantilla de configuración
# Copiar a .env y completar valores reales por entorno.
# ==============================================================

# --- APP ---
# Obligatorio: mínimo 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DEBUG=false
ENVIRONMENT=production

# --- BASE DE DATOS ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=agas_user
DATABASE_PASSWORD=
DATABASE_NAME=agas_cilindros
DATABASE_ECHO=false

# --- REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MINIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET_FILES=agas-files
MINIO_BUCKET_BACKUPS=agas-backups

# --- JWT (llaves RS256) ---
# Generar con:
#   openssl genrsa -out secrets/jwt_private.pem 2048
#   openssl rsa -in secrets/jwt_private.pem -pubout -out secrets/jwt_public.pem
JWT_PRIVATE_KEY_PATH=/app/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/secrets/jwt_public.pem

# --- CORS (lista JSON) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- LOGGING ---
LOG_LEVEL=INFO
LOG_FORMAT=json
